# Public .ics calendar URL (Google Calendar: Settings → "Secret address in iCal format")
ICS_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/basic.ics

# Exact name of the WhatsApp group to send the message to
WHATSAPP_GROUP_NAME=My Community Group

# Cron schedule — default is Monday at 08:00
# See https://crontab.guru for help building a schedule
CRON_SCHEDULE=0 8 * * 1

# PORT and WWEBJS_AUTH_PATH are set automatically by docker-compose.yml — do not add them here
